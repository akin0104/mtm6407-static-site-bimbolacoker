---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Projects">

<h1>My Projects</h1>

<div class="projects">

  <div class="project">
    <h2>Portfolio Website</h2>
    <p>
      Designed and developed a responsive personal portfolio website to
      showcase my education, skills, and projects.
    </p>
  </div>

  <div class="project">
    <h2>ENVEI</h2>
    <p>
      Co-founded ENVEI, a workforce measurement platform that helps align
      education with labour market needs through skills and workforce data.
    </p>
  </div>

  <div class="project">
    <h2>Interactive Media Design Projects</h2>
    <p>
      Completed multiple web development, UI/UX design, branding, and digital
      media projects during my studies at Algonquin College.
    </p>
  </div>

</div>

<style>

h1{
    text-align:center;
    margin-bottom:40px;
    color:#0f172a;
}

.projects{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:25px;
}

.project{
    background:white;
    padding:25px;
    border-radius:10px;
    box-shadow:0 2px 10px rgba(0,0,0,.1);
}

.project h2{
    margin-bottom:15px;
    color:#2563eb;
}

.project p{
    line-height:1.7;
}

</style>

</Layout>