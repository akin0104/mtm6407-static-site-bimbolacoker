---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Skills">

<h1>My Skills</h1>

<div class="skills">

    <div class="card">
        <h2>Web Development</h2>
        <p>HTML5, CSS3, JavaScript, Astro, Vue.js</p>
    </div>

    <div class="card">
        <h2>Design</h2>
        <p>Figma, Adobe Photoshop, Adobe Illustrator</p>
    </div>

    <div class="card">
        <h2>Programming</h2>
        <p>JavaScript, C#, SQL</p>
    </div>

    <div class="card">
        <h2>Business Skills</h2>
        <p>Business Analysis, Project Management, Digital Transformation</p>
    </div>

</div>

<style>

h1{
    text-align:center;
    margin-bottom:40px;
    color:#0f172a;
}

.skills{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:25px;
}

.card{
    background:white;
    padding:25px;
    border-radius:10px;
    box-shadow:0 2px 10px rgba(0,0,0,.1);
}

.card h2{
    margin-bottom:15px;
    color:#2563eb;
}

.card p{
    line-height:1.6;
}

</style>

</Layout>