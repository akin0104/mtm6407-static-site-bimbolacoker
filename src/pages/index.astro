---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Bimbola Coker | Portfolio">
  <main>
    <section class="hero">
      <div class="profile-image">
        <img src="/profile.jpg" alt="Bimbola Coker" />
      </div>

      <h1>Bimbola Coker</h1>

      <h2>Digital Designer | Interactive Media | Web & UX</h2>

      <p>
        Hello! My name is <strong>Bimbola Coker</strong>. I am an Interactive
        Media Design student at Algonquin College with a passion for web
        development, UI/UX design, digital media, and business analysis.
      </p>

      <div class="buttons">
        <a href="/projects" class="primary-button">View My Projects</a>
        <a href="/about" class="secondary-button">About Me</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 20px;
  }

  .profile-image {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 30px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .profile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    font-size: 3.5rem;
    margin: 0 0 10px;
    color: #17213f;
  }

  h2 {
    font-size: 1.4rem;
    font-weight: 500;
    color: #555;
    margin: 0 0 25px;
  }

  p {
    max-width: 750px;
    font-size: 1.2rem;
    line-height: 1.7;
    color: #333;
    margin-bottom: 35px;
  }

  .buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .primary-button,
  .secondary-button {
    padding: 14px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 1rem;
    transition: 0.2s ease;
  }

  .primary-button {
    background: #17213f;
    color: white;
  }

  .secondary-button {
    border: 2px solid #17213f;
    color: #17213f;
    background: white;
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 2.5rem;
    }

    h2 {
      font-size: 1.1rem;
    }

    p {
      font-size: 1rem;
    }
  }
</style>