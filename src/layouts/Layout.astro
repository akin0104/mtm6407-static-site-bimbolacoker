---
const { title = "Bimbola Coker Portfolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      font-family:Arial, Helvetica, sans-serif;
      background:#f5f5f5;
      color:#333;
    }

    header{
      background:#0f172a;
      color:white;
      padding:20px 0;
    }

    nav{
      max-width:1100px;
      margin:auto;
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:0 20px;
    }

    nav h1{
      font-size:24px;
    }

    nav ul{
      display:flex;
      list-style:none;
      gap:20px;
    }

    nav a{
      color:white;
      text-decoration:none;
      font-weight:bold;
    }

    nav a:hover{
      color:#38bdf8;
    }

    main{
      max-width:1100px;
      margin:auto;
      padding:40px 20px;
      min-height:80vh;
    }

    footer{
      background:#0f172a;
      color:white;
      text-align:center;
      padding:20px;
      margin-top:40px;
    }

    @media(max-width:768px){

      nav{
        flex-direction:column;
        gap:15px;
      }

      nav ul{
        flex-direction:column;
        text-align:center;
      }

    }

  </style>

</head>

<body>

<header>

<nav>

<h1>Bimbola Coker</h1>

<ul>
<li><a href="/">Home</a></li>
<li><a href="/about">About</a></li>
<li><a href="/skills">Skills</a></li>
<li><a href="/projects">Projects</a></li>
<li><a href="/contact">Contact</a></li>
</ul>

</nav>

</header>

<main>

<slot />

</main>

<footer>

<p>© 2026 Bimbola Coker | Interactive Media Design Portfolio</p>

</footer>

</body>

</html>